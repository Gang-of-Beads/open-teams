// Signing defaults for the Open Teams iOS app.
//
// Do not edit this file to add your Apple team. Copy Local.xcconfig.example to
// Local.xcconfig (ignored by git) and set DEVELOPMENT_TEAM and, if needed,
// PRODUCT_BUNDLE_IDENTIFIER there. The optional include below picks it up.

CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =
PRODUCT_BUNDLE_IDENTIFIER = io.github.openteams.ios

#include? "Local.xcconfig"
