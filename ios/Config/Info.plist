<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keys that build settings cannot generate. Xcode merges this file with the
  generated Info.plist (GENERATE_INFOPLIST_FILE = YES).

  UIBackgroundModes/audio lets the silent keep-alive clip, and with it the
  Teams page, keep running in the background (see BackgroundKeepAlive.swift).
-->
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
