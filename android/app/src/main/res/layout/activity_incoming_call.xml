<?xml version="1.0" encoding="utf-8"?>
<!-- After the native pre-call screen: dark stage, caller in the middle,
     decline (red) / video / audio (brand) at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/call_stage"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <FrameLayout
        android:layout_width="112dp"
        android:layout_height="112dp">

        <TextView
            android:id="@+id/initials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/avatar_background"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="40sp" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/CircleShape" />
    </FrameLayout>

    <TextView
        android:id="@+id/caller"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="#CCFFFFFF"
        android:textSize="16sp" />

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1.4" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout style="@style/IncomingAction">

            <ImageButton
                android:id="@+id/decline"
                style="@style/IncomingButton"
                android:background="@drawable/hang_up_background"
                android:contentDescription="@string/decline"
                android:src="@drawable/ic_call_end" />

            <TextView
                style="@style/IncomingLabel"
                android:text="@string/decline" />
        </LinearLayout>

        <LinearLayout style="@style/IncomingAction">

            <ImageButton
                android:id="@+id/accept_video"
                style="@style/IncomingButton"
                android:background="@drawable/accept_background"
                android:contentDescription="@string/answer_video"
                android:src="@drawable/ic_videocam" />

            <TextView
                style="@style/IncomingLabel"
                android:text="@string/answer_video" />
        </LinearLayout>

        <LinearLayout style="@style/IncomingAction">

            <ImageButton
                android:id="@+id/accept_audio"
                style="@style/IncomingButton"
                android:background="@drawable/accept_background"
                android:contentDescription="@string/answer"
                android:src="@drawable/ic_call" />

            <TextView
                style="@style/IncomingLabel"
                android:text="@string/answer" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
