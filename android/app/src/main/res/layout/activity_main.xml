<?xml version="1.0" encoding="utf-8"?>
<!-- After the native app's activity_main: DrawerLayout with a top bar (avatar,
     title, search), the content, and a bottom tab bar. -->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/main_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/top_bar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/avatar_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/open_drawer">

                    <TextView
                        android:id="@+id/avatar_initials"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:background="@drawable/avatar_background"
                        android:gravity="center"
                        android:textColor="@android:color/white"
                        android:textSize="13sp" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/avatar_image"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        app:shapeAppearanceOverlay="@style/CircleShape" />

                    <View
                        android:id="@+id/presence_dot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="11dp"
                        android:layout_marginTop="11dp"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/top_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/top_actions"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:orientation="horizontal" />

                <ImageButton
                    android:id="@+id/top_search"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/search"
                    android:src="@drawable/ic_search" />

                <LinearLayout
                    android:id="@+id/top_actions_end"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/web_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- A tab's last look while Teams rebuilds it; touches go through to the WebView. -->
                <ImageView
                    android:id="@+id/tab_snapshot"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:visibility="gone" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/brand" />
            </FrameLayout>

            <!-- In-call controls, after the native call screen: video, mic, audio route, share, hand, end. -->
            <LinearLayout
                android:id="@+id/call_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@drawable/call_bar_background"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="6dp"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/call_video"
                    style="@style/CallBarButton"
                    android:contentDescription="@string/toggle_video"
                    android:src="@drawable/ic_videocam_off" />

                <ImageButton
                    android:id="@+id/call_mic"
                    style="@style/CallBarButton"
                    android:contentDescription="@string/mute"
                    android:src="@drawable/ic_mic" />

                <ImageButton
                    android:id="@+id/call_audio"
                    style="@style/CallBarButton"
                    android:contentDescription="@string/audio_route"
                    android:src="@drawable/ic_volume_up" />

                <ImageButton
                    android:id="@+id/call_share"
                    style="@style/CallBarButton"
                    android:contentDescription="@string/share_screen"
                    android:src="@drawable/ic_screen_share" />

                <ImageButton
                    android:id="@+id/call_hand"
                    style="@style/CallBarButton"
                    android:contentDescription="@string/raise_hand"
                    android:src="@drawable/ic_pan_tool" />

                <ImageButton
                    android:id="@+id/call_hang_up"
                    style="@style/CallBarButton"
                    android:background="@drawable/hang_up_background"
                    android:contentDescription="@string/hang_up"
                    android:src="@drawable/ic_call_end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bottom_nav"
                android:layout_width="match_parent"
                android:layout_height="@dimen/bottom_bar_height"
                android:orientation="horizontal"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/fullscreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black"
            android:visibility="gone" />
    </FrameLayout>

    <!-- The native app's side drawer: profile and status, then app actions. -->
    <ScrollView
        android:id="@+id/drawer_panel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/colorSurface"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/drawer_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp">

                    <TextView
                        android:id="@+id/drawer_initials"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/avatar_background"
                        android:gravity="center"
                        android:textColor="@android:color/white"
                        android:textSize="20sp" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/drawer_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        app:shapeAppearanceOverlay="@style/CircleShape" />

                    <View
                        android:id="@+id/drawer_presence"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="bottom|end"
                        android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/drawer_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <TextView
                        android:id="@+id/drawer_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <TextView
                        android:id="@+id/drawer_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorOutlineVariant" />

            <TextView
                android:id="@+id/drawer_set_status"
                style="@style/SheetRow"
                android:drawableStart="@drawable/ic_account_status"
                android:text="@string/set_status" />

            <TextView
                android:id="@+id/drawer_search"
                style="@style/SheetRow"
                android:drawableStart="@drawable/ic_search"
                android:text="@string/search" />

            <TextView
                android:id="@+id/drawer_all_apps"
                style="@style/SheetRow"
                android:drawableStart="@drawable/ic_apps"
                android:text="@string/all_apps" />

            <TextView
                android:id="@+id/drawer_teams_settings"
                style="@style/SheetRow"
                android:drawableStart="@drawable/ic_more_horiz"
                android:text="@string/teams_settings" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="?attr/colorOutlineVariant" />

            <TextView
                android:id="@+id/drawer_join"
                style="@style/SheetRow"
                android:drawableStart="@drawable/ic_video_call"
                android:text="@string/join_meeting" />

            <TextView
                android:id="@+id/drawer_dial"
                style="@style/SheetRow"
                android:drawableStart="@drawable/ic_dialpad"
                android:text="@string/call_number" />

            <TextView
                android:id="@+id/drawer_reload"
                style="@style/SheetRow"
                android:drawableStart="@drawable/ic_refresh"
                android:text="@string/reload" />

            <TextView
                android:id="@+id/drawer_settings"
                style="@style/SheetRow"
                android:drawableStart="@drawable/ic_settings"
                android:text="@string/settings" />
        </LinearLayout>
    </ScrollView>
</androidx.drawerlayout.widget.DrawerLayout>
